{
  "name": "jev-hearthstone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "smoke": "node --env-file-if-exists=.env.local src/smoke.mjs",
    "test": "node --test",
    "decide": "node --env-file-if-exists=.env.local src/decide.mjs",
    "calibrate": "node src/calibrate.mjs",
    "play": "node --env-file-if-exists=.env.local src/play.mjs",
    "verify": "node src/verify-decision.mjs",
    "loop": "node src/loop.mjs",
    "override": "node --env-file-if-exists=.env.local src/override.mjs",
    "gestures": "node src/gesture-report.mjs",
    "game": "node src/await-game.mjs && node src/loop.mjs > runtime/last-game.log 2>&1",
    "selfplay": "node src/selfplay.mjs",
    "selfplay-train": "python train/ppo.py",
    "eval-pick": "node src/eval-pick.mjs",
    "eval-silverfish": "node src/eval-silverfish.mjs",
    "eval-strength": "node src/eval-strength.mjs",
    "eval-model-pair": "node --env-file-if-exists=.env.local src/eval-model-pair.mjs",
    "eval-sim-fidelity": "node src/eval-sim-fidelity.mjs",
    "eval-mulligan-cohorts": "node src/eval-mulligan-cohorts.mjs",
    "eval-rulings": "node src/eval-rulings.mjs",
    "label": "node src/eval-label.mjs",
    "eval": "node --env-file-if-exists=.env.local src/eval-score.mjs",
    "eval-combo-admission": "node src/eval-combo-admission.mjs",
    "shadow": "node src/eval-shadow.mjs"
  },
  "dependencies": {
    "ai": "7.0.107"
  }
}
